# ==========================================
# Target & Device Configuration
# ==========================================
CONFIG_TARGET_msm89xx=y
CONFIG_TARGET_msm89xx_generic=y
CONFIG_TARGET_msm89xx_generic_DEVICE_sp970=y

# ==========================================
# Rootfs & Overlay (Scheme A: SquashFS + Ext4 Dynamic)
# ==========================================
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_PARTSIZE=64

# 自动扩容与存储管理
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_partexp=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y

# ==========================================
# Base System & LuCI
# ==========================================
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_default-settings-chn=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-cpu-status=y
CONFIG_PACKAGE_luci-app-temp-status=y
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-adblock-fast=y

# Theme
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ==========================================
# Modem / WWAN / Cellular
# ==========================================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-quectel=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_chat=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_comgt-ncm=y
CONFIG_PACKAGE_wwan=y
CONFIG_PACKAGE_qmi-utils=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_mbim-utils=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_modemmanager=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_modeminfo=y
CONFIG_PACKAGE_modeminfo-qmi=y
CONFIG_PACKAGE_luci-app-modeminfo=y
CONFIG_PACKAGE_luci-app-mmconfig=y

# SP970v11 专属固件
CONFIG_PACKAGE_qcom-msm8916-modem-openstick-sp970v11-firmware=y
CONFIG_PACKAGE_qcom-msm8916-openstick-sp970v11-wcnss-firmware=y
CONFIG_PACKAGE_qcom-msm8916-wcnss-openstick-sp970v11-nv=y

# ==========================================
# WiFi & Bluetooth (Internal + External)
# ==========================================
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-wcn36xx=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y
CONFIG_PACKAGE_kmod-bluetooth=y
CONFIG_PACKAGE_bluez-daemon=y
CONFIG_PACKAGE_bluez-utils=y

# 外部 USB WiFi / 网卡驱动
CONFIG_PACKAGE_kmod-rtl8188eu=y
CONFIG_PACKAGE_kmod-rtl8xxxu=y
CONFIG_PACKAGE_kmod-rtw88=y
CONFIG_PACKAGE_kmod-rtw88-8821c=y
CONFIG_PACKAGE_kmod-rtw88-8821cu=y
CONFIG_PACKAGE_kmod-rtw88-usb=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_r8152-firmware=y
CONFIG_PACKAGE_rtl8188eu-firmware=y
CONFIG_PACKAGE_rtl8821ce-firmware=y

# ==========================================
# Virtual Networking (Tailscale / ZeroTier / Cloudflare)
# ==========================================
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_cloudflared=y

# ==========================================
# Daed Proxy & eBPF/XDP Kernel Modules
# ==========================================
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_kmod-bpf-devmap=y
CONFIG_PACKAGE_libbpf1=y

# ==========================================
# Podman Container Stack
# ==========================================
CONFIG_PACKAGE_podman=y
CONFIG_PACKAGE_conmon=y
CONFIG_PACKAGE_crun=y
CONFIG_PACKAGE_netavark=y
CONFIG_PACKAGE_fuse-overlayfs=y
CONFIG_PACKAGE_slirp4netns=y
CONFIG_PACKAGE_fuse-utils=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libseccomp=y

# ==========================================
# Debug / Comms / Utilities
# ==========================================
CONFIG_PACKAGE_lpac=y
CONFIG_PACKAGE_qtools=y
CONFIG_PACKAGE_atinout=y
CONFIG_PACKAGE_evtest=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_usbids=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_shellsync=y
CONFIG_PACKAGE_qmi-modem-410-init=y
CONFIG_PACKAGE_adb=y
CONFIG_PACKAGE_android-tools-adbd=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_filebrowser=y
CONFIG_PACKAGE_luci-app-filebrowser-go=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_speedtest-cli=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_fwtool=y
CONFIG_PACKAGE_reboot-helper=y

# ==========================================
# Network & Firewall Core
# ==========================================
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
