# ==========================================
# Explicitly Disabled (Conflict/Bloat Workaround)
# ==========================================
# 规避 GCC 14 + musl 的 fortify-headers 符号重定义冲突
# CONFIG_PACKAGE_gpgme is not set
# CONFIG_PACKAGE_libgpg-error is not set
# CONFIG_PACKAGE_libgcrypt is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set